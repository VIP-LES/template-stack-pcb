	(text "CANBUS Transciever"
		(exclude_from_sim no)
		(at 33.274 16.764 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "3a47731a-4cde-42e6-871f-0f5f44222d02")
	)
	(text "CANbus is a system that allows each module to send data to any listening\nreceiver without coordination from a master controller.\n\nThis flexible network allows us to design modules that can operate independently\nfrom the stack and prevents a single point of failure.\n\nWe use CAN-FD, an extended protocol that operates at 4-8 Mbps as our main data \nnetwork for the entire payload."
		(exclude_from_sim no)
		(at 14.224 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5022354c-8274-4833-83f4-a37697839337")
	)
	(text "Decoupling capacitors.\nThese must be placed close to the power pins on the ICs."
		(exclude_from_sim no)
		(at 16.002 105.918 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b5a8e8aa-01b9-483f-875b-9fcc843df7f1")
	)
